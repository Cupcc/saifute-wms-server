{
  "name": "saifute-wms-server-nestjs",
  "version": "0.1.6",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "audit:openapi": "bun ./scripts/openapi-contract-audit.mjs",
    "biome": "biome check .",
    "build": "nest build --path tsconfig.build.json",
    "build:prod": "bun --env-file .env.prod prisma generate --schema prisma/schema.prisma && bun run build",
    "commitlint": "commitlint --edit",
    "dev": "bun run --env-file .env.dev prisma:generate && nest start --watch --exec bun --path tsconfig.app.json --env-file .env.dev",
    "dev:node": "bun run --env-file .env.dev prisma:generate && nest start --watch --path tsconfig.app.json --env-file .env.dev",
    "dev:web": "bun --cwd web dev",
    "docs:search": "bun ./scripts/knowledge/search-doc-catalog.mjs",
    "format": "biome check . --write",
    "lint": "biome check .",
    "lint:src-lines": "bun ./scripts/scan-src-ts-file-lines.mjs --max-lines 500 --no-error",
    "lint:src-lines:strict": "bun ./scripts/scan-src-ts-file-lines.mjs --max-lines 1000",
    "lint:staged": "lint-staged",
    "prisma:rebuild:collation": "bun --env-file .env.dev ./scripts/rebuild-collation.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "prisma:push": "bun --env-file .env.dev prisma db push --schema prisma/schema.prisma && bun run --env-file .env.dev prisma:generate",
    "prisma:validate": "prisma validate",
    "start": "bun dist/src/main.js",
    "start:prod": "bun --env-file .env.prod dist/src/main.js",
    "start:node": "node dist/src/main.js",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "eventemitter2": "^6.4.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "mariadb": "^3.5.2",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.16",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.3.4",
    "prisma": "^7.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
